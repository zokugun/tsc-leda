{
	"name": "@zokugun/tsc-leda",
	"description": "CLI utility compiling (with `tsc`) and preparing TS projects for dual ESM/CJS distribution",
	"version": "0.5.0",
	"author": {
		"name": "Baptiste Augrain",
		"email": "daiyam@zokugun.org"
	},
	"license": "MIT",
	"homepage": "https://github.com/zokugun/tsc-leda",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/zokugun/tsc-leda.git"
	},
	"bugs": {
		"url": "https://github.com/zokugun/tsc-leda/discussions/categories/issue-triage"
	},
	"engines": {
		"node": ">=18.20"
	},
	"type": "module",
	"bin": {
		"tsc-leda": "bin/tsc-leda"
	},
	"scripts": {
		"audit:fix": "npm audit fix --min-release-age=0",
		"build": "npm run clean && npm run compile:src",
		"ci:lint": "zizmor .",
		"ci:lint:fix": "zizmor . --fix=all",
		"clean": "rimraf lib",
		"compile:src": "tsc -p src",
		"lint": "eslint",
		"lint:all": "npm audit && npm run lint:package && npm run ci:lint && npm run lint",
		"lint:fix": "eslint --fix",
		"lint:package": "fixpack || true",
		"prepack": "npm run build",
		"prepare": "husky; npm run lint:package",
		"release": "release-it",
		"update:artifacts": "artifact update",
		"update:ci": "pinact run -min-age 7 -update",
		"update:deps": "taze --all",
		"watch:build": "tsc-watch -p src --onSuccess 'npm run build'",
		"watch:src": "tsc-watch -p src"
	},
	"dependencies": {
		"@zokugun/cli-utils": "0.3.3",
		"@zokugun/fs-extra-plus": "0.6.1",
		"@zokugun/is-it-type": "0.8.1",
		"@zokugun/text-line-utils": "0.1.0",
		"@zokugun/xtry": "0.11.6",
		"execa": "9.6.1",
		"globby": "14.1.0",
		"yaml": "2.9.0"
	},
	"devDependencies": {
		"@commitlint/cli": "20.5.3",
		"@commitlint/config-conventional": "20.5.3",
		"@types/node": "20.19.43",
		"eslint": "10.8.1",
		"fixpack": "4.0.0",
		"husky": "9.1.7",
		"lint-staged": "16.4.0",
		"release-it": "20.2.1",
		"rimraf": "6.1.3",
		"taze": "19.16.0",
		"tsc-watch": "7.2.1",
		"typescript": "5.9.3"
	},
	"overrides": {
		"@inquirer/core": {
			"mute-stream": "3.0.0"
		},
		"release-it": {
			"undici": "7.29.0"
		}
	},
	"allowScripts": {
		"@zokugun/cli-utils": true
	},
	"keywords": [
		"cjs",
		"commonjs",
		"esm",
		"tsc"
	]
}
